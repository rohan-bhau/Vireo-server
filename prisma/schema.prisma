generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SprintStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum WorkspaceRole {
  ADMIN
  EDIT
  VIEW
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  description String?
  avatar      String?
  ownerId     String
  template    ProjectTemplate   @default(KANBAN)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  invitations Invitation[]
  projects    Project[]

  @@map("workspaces")
}

model WorkspaceMember {
  id         String        @id @default(uuid())
  workspaceId String
  userId     String
  role       WorkspaceRole @default(EDIT)
  joinedAt   DateTime      @default(now())
  invitedBy  String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Invitation {
  id           String            @id @default(uuid())
  workspaceId  String
  inviterId    String
  inviteeEmail String
  role         WorkspaceRole     @default(EDIT)
  message      String?
  token        String            @unique
  status       InvitationStatus  @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime          @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

enum ProjectTemplate {
  SCRUM
  KANBAN
  BUG_TRACKING
  PROJECT_MANAGEMENT
  DEVOPS
  TASK_TRACKING
  BLANK
}

enum BoardType {
  SCRUM
  KANBAN
}

model Project {
  id                   String          @id @default(uuid())
  name                 String
  description          String?
  key                  String
  workspaceId          String
  ownerId              String
  template             ProjectTemplate @default(SCRUM)
  avatar               String?
  isTeamManaged        Boolean         @default(true)
  permissionSchemeId   String?
  issueSecuritySchemeId String?
  enabledIssueTypes    String[]        @default([])
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boards    Board[]
  sprints   Sprint[]

  @@unique([workspaceId, key])
  @@map("projects")
}

model Board {
  id        String    @id @default(uuid())
  name      String
  type      BoardType @default(SCRUM)
  projectId String
  config    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns Column[]

  @@map("boards")
}

model Column {
  id        String   @id @default(uuid())
  name      String
  position  Int
  boardId   String
  wipLimit  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([boardId, position])
  @@map("columns")
}

model Sprint {
  id            String        @id @default(uuid())
  name          String
  goal          String?
  goalCompleted Boolean?
  projectId     String
  status        SprintStatus  @default(PLANNING)
  startDate     DateTime?
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("sprints")
}
